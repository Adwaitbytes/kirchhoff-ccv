# Base URL of the KIRCHHOFF REST + WebSocket API (no trailing slash, includes /v1 if the API mounts there).
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
# "api" (default, real onchain mirror) or "fixtures" (deterministic dev data, never allowed on a production deploy).
NEXT_PUBLIC_DATA_SOURCE=api
# Public RPC endpoints used only for the read-only "verify onchain" reads.
NEXT_PUBLIC_RPC_ETH_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RPC_ARB_SEPOLIA=https://arbitrum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RPC_BASE_SEPOLIA=https://base-sepolia-rpc.publicnode.com
# "auto" (default: SSE on *.vercel.app hosts, WebSocket elsewhere), "ws" or "sse".
NEXT_PUBLIC_STREAM_TRANSPORT=auto
