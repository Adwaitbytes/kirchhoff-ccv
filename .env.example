# KIRCHHOFF environment. Copy to .env and fill in. Never commit .env.
# `make check-creds` prints which of these are present and working.

# ---------- Wallets (TESTNET ONLY, never reuse on mainnet) ----------
# Deployer: deploys every contract and pays gas on all 3 testnets. Needs ETH + LINK on each chain.
DEPLOYER_PRIVATE_KEY=
# Attacker wallet used by the Kelp Replay (funded by the deployer automatically).
ATTACKER_PRIVATE_KEY=
# The single WeakBridge verifier key (the "1-of-1 verifier" being abused in the demo).
WEAKBRIDGE_VERIFIER_PRIVATE_KEY=
# Issuer Safe owners (2-of-3). The Safe itself is deployed by demo/deploy-all.
SAFE_SIGNER_1_PRIVATE_KEY=
SAFE_SIGNER_2_PRIVATE_KEY=
SAFE_SIGNER_3_PRIVATE_KEY=
# Filled by demo/deploy-all after it deploys the Safe.
ISSUER_SAFE_ADDRESS=

# ---------- RPC providers: two independent providers per chain ----------
# Optional keyed provider; when set, CRE simulation uses it first (keyless endpoints rate-limit under bursts).
ALCHEMY_API_KEY=
RPC_ETH_SEPOLIA_1=
RPC_ETH_SEPOLIA_2=https://ethereum-sepolia-rpc.publicnode.com
RPC_ARB_SEPOLIA_1=
RPC_ARB_SEPOLIA_2=https://arbitrum-sepolia-rpc.publicnode.com
RPC_BASE_SEPOLIA_1=
RPC_BASE_SEPOLIA_2=https://base-sepolia-rpc.publicnode.com

# ---------- Contract verification and explorer data ----------
# Etherscan API V2: one key covers Sepolia, Arbitrum Sepolia and Base Sepolia.
ETHERSCAN_API_KEY=
# Blockscout needs no key for these testnets; override only if you run your own.
BLOCKSCOUT_ETH_SEPOLIA_URL=https://eth-sepolia.blockscout.com/api
BLOCKSCOUT_ARB_SEPOLIA_URL=https://arbitrum-sepolia.blockscout.com/api
BLOCKSCOUT_BASE_SEPOLIA_URL=https://base-sepolia.blockscout.com/api

# ---------- Chainlink CRE ----------
# Set by `cre login` (stored by the CLI). Optional API key for non-interactive CI use.
CRE_API_KEY=
# "simulate" (default) or "live" once Chainlink grants deploy access.
CRE_DEPLOY_MODE=simulate
CRE_ETH_PRIVATE_KEY=

# ---------- Judge (CCV policy hook) ----------
# Shared HMAC-SHA256 secret between the CCV verifier and the Judge. Generated by `make secrets`.
JUDGE_HMAC_SECRET=
JUDGE_PORT=8787
JUDGE_TIME_BUDGET_MS=2000
JUDGE_SPEC_SYNC_SECONDS=60

# ---------- Data plane (UI read model, not in the veto path) ----------
DATABASE_URL=postgres://kirchhoff:kirchhoff@localhost:5432/kirchhoff
API_PORT=8080
API_PUBLIC_URL=http://localhost:8080
ISSUER_API_KEY=

# ---------- AI (never in the veto path) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Notifier (optional; at least one channel recommended) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# ---------- Infra ----------
# Optional cloud VM for k3s. Leave empty to run the CCV cell locally in k3d.
CCV_VM_SSH=
# ---------- Deploy ----------
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
GITHUB_REPO=Adwaitbytes/kirchhoff-ccv
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_NETWORK=testnet
DATABASE_URL_HOSTED=
VERCEL_REGION=sin1
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5
VERDICT_SINK_URL=
INTERNAL_INGEST_KEY=
