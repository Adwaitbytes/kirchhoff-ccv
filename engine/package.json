{
  "name": "@kirchhoff/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KIRCHHOFF invariant engine: pure bigint Junction and Loop rules shared by the CRE workflows, the Judge and the backtester",
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./spec": "./src/spec/index.ts",
    "./compile": "./src/compile.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "compile": "node bin/compile.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "viem": "^2.57.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
